{{!
    @template tool_ceaorganizador/page

    Main page of the category organiser.

    Context variables required for this template:
    * id - Unique DOM id of the root element
    * nativeurl - URL of the native course management page

    Example context (json):
    {
        "id": "tool-ceaorganizador-example",
        "nativeurl": "https://example.org/course/management.php"
    }
}}
<div id="{{id}}" class="tool-ceaorganizador" data-region="ceaorganizador">
    <p>{{#str}}intro, tool_ceaorganizador{{/str}}</p>
    <p><a class="btn btn-secondary" href="{{nativeurl}}">{{#str}}nativemanagement, tool_ceaorganizador{{/str}}</a></p>
    <h2 class="h4">{{#str}}treeheading, tool_ceaorganizador{{/str}}</h2>
    <div data-region="tree"></div>
    {{> tool_ceaorganizador/credito}}
</div>
