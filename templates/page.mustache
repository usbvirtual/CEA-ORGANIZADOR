{{!
    @template tool_ceaorganizador/page

    Main page of the category organiser.

    Context variables required for this template:
    * id - Unique DOM id of the root element
    * nativeurl - URL of the native course management page

    Example context (json):
    {
        "id": "tool-ceaorganizador-example",
        "nativeurl": "https://example.org/course/management.php"
    }
}}
<div id="{{id}}" class="tool-ceaorganizador" data-region="ceaorganizador">
    <p>{{#str}}intro, tool_ceaorganizador{{/str}}</p>
    <div class="tool-ceaorganizador-barra">
        <input type="search" class="form-control" data-region="search"
               aria-label="{{#str}}search, tool_ceaorganizador{{/str}}"
               placeholder="{{#str}}searchplaceholder, tool_ceaorganizador{{/str}}">
        <div class="tool-ceaorganizador-resumen" data-region="summary" hidden>
            <span data-region="summarytext"></span>
            <span aria-hidden="true">&middot;</span>
            <button type="button" class="btn btn-secondary btn-sm" data-action="reviewsort">{{#str}}review, tool_ceaorganizador{{/str}}</button>
        </div>
        <div class="tool-ceaorganizador-resumen" data-region="dupsummary" hidden>
            <span id="{{id}}-dupsummarytext" data-region="dupsummarytext"></span>
            <span aria-hidden="true">&middot;</span>
            <button type="button" class="btn btn-secondary btn-sm" data-action="reviewdups"
                    aria-describedby="{{id}}-dupsummarytext">{{#str}}review, tool_ceaorganizador{{/str}}</button>
        </div>
    </div>
    <h2 class="h4">{{#str}}treeheading, tool_ceaorganizador{{/str}}</h2>
    <div data-region="tree"></div>
    <ul class="tool-ceaorganizador-resultados" data-region="courseresults" aria-live="polite"></ul>
    <p><a class="btn btn-secondary" href="{{nativeurl}}">{{#str}}nativemanagement, tool_ceaorganizador{{/str}}</a></p>
    {{> tool_ceaorganizador/credito}}
</div>
